# YardScale Digital — environment configuration. Every value is optional:
# the site builds and runs without any of them. See docs/SETUP.md.

NEXT_PUBLIC_SITE_URL=https://yardscaledigital.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@yardscaledigital.com

# ---- Content switches (no redesign needed) --------------------------
# Hero video: any YouTube / Vimeo / .mp4 link. Or edit src/content/site.ts.
NEXT_PUBLIC_HERO_VIDEO_URL=
# Community invite links. Empty = "not open yet" state is shown.
NEXT_PUBLIC_SKOOL_URL=
NEXT_PUBLIC_DISCORD_URL=
# Optional scheduler link for suitable coaching applicants (not shown publicly).
NEXT_PUBLIC_BOOKING_URL=

# ---- Lead storage (Supabase) ----------------------------------------
# Run supabase/migrations/20261109_create_leads.sql first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email (Resend) -------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend.
RESEND_FROM_EMAIL=
# Where applications and signups are announced to Andrew.
LEAD_NOTIFICATION_EMAIL=
# Optional: also add subscribers to a Resend audience for broadcasts.
RESEND_AUDIENCE_ID=

# ---- Optional webhooks (Zapier / Make / Slack / CRM) ----------------
FORM_WEBHOOK_URL=
SUBSCRIBER_WEBHOOK_URL=
APPLICATION_WEBHOOK_URL=
FORM_WEBHOOK_TOKEN=

# ---- Member sessions ------------------------------------------------
# Long random string. REQUIRED in production for Academy / course sign-in.
GROWTH_SYSTEM_SESSION_SECRET=
