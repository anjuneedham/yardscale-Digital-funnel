# ------------------------------------------------------------------
# YardScale Digital — environment configuration
# Copy to .env.local and fill in what applies. Every value is optional:
# the site is fully functional without any of them.
# ------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://yardscaledigital.com

# Public contact address shown in the footer and on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yardscaledigital.com

# ---- Booking -------------------------------------------------------
# Any scheduler that can be embedded and linked (Cal.com, Calendly,
# SavvyCal, HubSpot Meetings...). When set, /book embeds it and every
# "Book a growth call" CTA points at it directly.
# Leave empty to fall back to the on-site growth request form.
NEXT_PUBLIC_BOOKING_URL=

# ---- Starter guide delivery -----------------------------------------
# Sends the Growth System Starter Guide PDF directly via Resend when someone
# submits the lead magnet form. Get a key at resend.com. RESEND_FROM_EMAIL
# must be on a domain verified in Resend — falls back to the contact email
# above, which will fail to send until that domain is verified too.
# Leave RESEND_API_KEY empty and the form still succeeds; nothing is emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ---- Form / CRM delivery -------------------------------------------
# Submissions are POSTed as JSON to the endpoint you configure. Point these
# at Zapier, Make, HubSpot, ConvertKit, Airtable, a Slack webhook, or your
# own endpoint. No provider is hard-coded anywhere in the codebase.
#
# FORM_WEBHOOK_URL is the fallback used by any submission type that has no
# dedicated endpoint set.
FORM_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
QUALIFICATION_WEBHOOK_URL=
GROWTH_REQUEST_WEBHOOK_URL=

# Optional bearer token sent as `Authorization: Bearer <token>` on every
# forwarded submission.
FORM_WEBHOOK_TOKEN=
