# ------------------------------------------------------------------
# YardScale Digital — environment configuration
# Copy to .env.local and fill in what applies. Every value is optional:
# the site is fully functional without any of them.
# ------------------------------------------------------------------

# Canonical origin. Used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://yardscaledigital.com

# Public contact address shown in the footer and on /contact.
NEXT_PUBLIC_CONTACT_EMAIL=hello@yardscaledigital.com

# ---- Booking -------------------------------------------------------
# Any scheduler that can be embedded and linked (Cal.com, Calendly,
# SavvyCal, HubSpot Meetings...). When set, /book embeds it and every
# "Book a growth call" CTA points at it directly.
# Leave empty to fall back to the on-site growth request form.
NEXT_PUBLIC_BOOKING_URL=

# ---- Email delivery (Resend) ----------------------------------------
# Set RESEND_API_KEY to enable email notifications via Resend.
# Get a key at resend.com. RESEND_FROM_EMAIL must be on a domain verified in
# Resend — falls back to NEXT_PUBLIC_CONTACT_EMAIL, which will fail to send
# until verified. Leave empty and forms still work; nothing is emailed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Notification email for new Growth Call submissions (internal team).
# When set (with RESEND_API_KEY), the team receives an email for each new
# growth call request. Leave empty to skip growth call notifications.
GROWTH_CALL_NOTIFICATION_EMAIL=

# ---- Growth Operator System (course access) -------------------------
# Provider-agnostic access layer for the /growth-system member area.
# Both are optional in preview (safe dev fallbacks) and should be set for
# production. See docs/growth-operator-system/ARCHITECTURE.md.
#
# Signs the member session + progress cookies. Set a long random string in
# production. Without it, an insecure development secret is used.
GROWTH_SYSTEM_SESSION_SECRET=
# Placeholder enrollment code that grants course access until a real payment
# provider is connected. When unset, the login page shows the default preview
# code so reviewers can sign in. Replace the check in access.ts with a real
# paid-enrollment lookup before charging.
GROWTH_SYSTEM_ACCESS_CODE=

# ---- Database (Supabase) -------------------------------------------
# Growth call submissions are stored in Supabase. Get these from your Supabase project.
# NEXT_PUBLIC_SUPABASE_URL: project URL (safe to expose publicly)
# SUPABASE_SERVICE_ROLE_KEY: server-side secret key (NEVER expose to client)
# Leave both empty and submissions still work — they're just not stored in the database.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Form / CRM delivery -------------------------------------------
# Submissions are POSTed as JSON to the endpoint you configure. Point these
# at Zapier, Make, HubSpot, ConvertKit, Airtable, a Slack webhook, or your
# own endpoint. No provider is hard-coded anywhere in the codebase.
#
# FORM_WEBHOOK_URL is the fallback used by any submission type that has no
# dedicated endpoint set.
FORM_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
QUALIFICATION_WEBHOOK_URL=
GROWTH_REQUEST_WEBHOOK_URL=

# Optional bearer token sent as `Authorization: Bearer <token>` on every
# forwarded submission.
FORM_WEBHOOK_TOKEN=
